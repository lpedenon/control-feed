{
  "name": "no-brainrot",
  "description": "Take back your attention. Hide Shorts, Reels, recommendations and endless feeds on YouTube and Instagram.",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "author": "lpedenon",
  "homepage": "https://github.com/lpedenon/no-brainrot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpedenon/no-brainrot.git"
  },
  "bugs": {
    "url": "https://github.com/lpedenon/no-brainrot/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && playwright test --project=fixtures",
    "test:live": "wxt build && playwright test --project=live",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18"
  }
}
